@model Mission6.Models.Application

@{
    ViewData["Title"] = "Edit Movie";
}

<div class="text-center">
    <h1 class="display-4">Edit Movie</h1>
    <br />

    <form asp-action="Edit" method="post">
        <div>
            <input type="hidden" asp-for="MovieId"/>
        </div>

        
        <div>
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="CategoryId">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                <option value="">-- Select a Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>



        <div>
            <label asp-for="Year"></label>
            <input asp-for="Year" class="form-control" />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Director"></label>
            <input asp-for="Director" class="form-control" />
            <span asp-validation-for="Director" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Rating"></label>
            <select asp-for="Rating" class="form-control">
                <option value="">-- Select Rating --</option>
                <option value="TV-G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
                <option value="UR">UR</option>
            </select>
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Edited"></label>
            <select asp-for="Edited" class="form-control">
                <option value="">-- Select --</option>
                <option value="1">Yes</option>
                <option value="0">No</option>
            </select>
        </div>

        <div>
            <label asp-for="CopiedToPlex">Copied To Plex</label>
            <select asp-for="CopiedToPlex" class="form-control">
                <option value="">-- Select --</option>
                <option value="1">Yes</option>
                <option value="0">No</option>
            </select>
        </div>

        <div>
            <label asp-for="LentTo"></label>
            <input asp-for="LentTo" class="form-control" />
        </div>

        <div>
            <label asp-for="Notes"></label>
            <input asp-for="Notes" class="form-control" maxlength="25" />
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <br />
        <button type="submit" class="btn btn-primary">Submit Movie</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
